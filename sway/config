################
### MONITORS ###
################
output * res 1366x768 position 0 0

###################
### MY PROGRAMS ###
###################
set $terminal alacritty
set $fileManager nautilus
set $menu qs -c noctalia-shell ipc call launcher toggle
set $emoji qs -c noctalia-shell ipc call launcher emoji
set $clipboard qs -c noctalia-shell ipc call launcher clipboard
set $browser helium

set $screenshot bash ~/.config/sway/scripts/screenshot.sh
set $colorPicker grim -g "$(slurp -p)" -t ppm - | convert - -format '%[pixel:p{0,0}]' txt:- | wl-copy

#################
### AUTOSTART ###
#################
# Quickshell
exec qs -c noctalia-shell

# Autotiler (python package)
exec autotiling

# Idle lockscreen
exec swayidle -w \
    before-sleep 'qs -c noctalia-shell ipc call lockScreen lock' \
    lock 'qs -c noctalia-shell ipc call lockScreen lock'

# Start MATE Polkit agent
exec /usr/libexec/polkit-mate-authentication-agent-1

# Start GNOME Keyring daemon
exec gnome-keyring-daemon --start --components=secrets

exec keepassxc
exec kdeconnect-indicator

exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store

#############################
### ENVIRONMENT VARIABLES ###
#############################
exec systemctl --user import-environment DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP
exec dbus-update-activation-environment --all
exec dbus-update-activation-environment --systemd XCURSOR_THEME=catppuccin-mocha-dark-cursors XCURSOR_SIZE=24

seat seat0 xcursor_theme catppuccin-mocha-light-cursors 24

#####################
### LOOK AND FEEL ###
#####################
gaps inner 5
gaps outer 4

default_border pixel 2
client.focused #33ccff #33ccff #ffffff #00ff99
client.focused_inactive #595959 #595959 #ffffff #595959

### SwayFX Effects ###
corner_radius 10
shadows enable
shadow_blur_radius 20
shadow_color #0000007F

blur enable
blur_passes 2
blur_radius 6

# SwayFX dimming
default_dim_inactive 0.2

################
###   INPUT  ###
################
input "type:keyboard" {
    xkb_layout au
}

input "type:touchpad" {
    tap enabled
    natural_scroll disabled
}

###################
### KEYBINDINGS ###
###################
set $mainMod Mod4

bindsym $mainMod+Return exec $terminal
bindsym $mainMod+Shift+q kill
bindsym $mainMod+Shift+m exec swaymsg exit
bindsym $mainMod+e exec $fileManager
bindsym $mainMod+Shift+space floating toggle
bindsym $mainMod+space exec $menu
bindsym $mainMod+period exec $emoji
bindsym $mainMod+f exec $browser

# Tools
bindsym $mainMod+Shift+c exec $colorPicker
bindsym $mainMod+Shift+s exec $screenshot
bindsym $mainMod+w exec waypaper
bindsym $mainMod+l exec qs -c noctalia-shell ipc call lockScreen lock
bindsym $mainMod+Escape exec qs -c noctalia-shell ipc call sessionMenu toggle

# Clipboard
bindsym $mainMod+v exec $clipboard

# Focus
bindsym $mainMod+Left focus left
bindsym $mainMod+Right focus right
bindsym $mainMod+Up focus up
bindsym $mainMod+Down focus down

# Workspaces (1-0)
bindsym $mainMod+1 workspace number 1
bindsym $mainMod+2 workspace number 2
bindsym $mainMod+3 workspace number 3
bindsym $mainMod+4 workspace number 4
bindsym $mainMod+5 workspace number 5
bindsym $mainMod+6 workspace number 6
bindsym $mainMod+7 workspace number 7
bindsym $mainMod+8 workspace number 8
bindsym $mainMod+9 workspace number 9
bindsym $mainMod+0 workspace number 10

# Move to Workspaces (1-0)
bindsym $mainMod+Shift+1 move container to workspace number 1
bindsym $mainMod+Shift+2 move container to workspace number 2
bindsym $mainMod+Shift+3 move container to workspace number 3
bindsym $mainMod+Shift+4 move container to workspace number 4
bindsym $mainMod+Shift+5 move container to workspace number 5
bindsym $mainMod+Shift+6 move container to workspace number 6
bindsym $mainMod+Shift+7 move container to workspace number 7
bindsym $mainMod+Shift+8 move container to workspace number 8
bindsym $mainMod+Shift+9 move container to workspace number 9
bindsym $mainMod+Shift+0 move container to workspace number 10

# Media Keys
bindsym XF86AudioRaiseVolume exec wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86MonBrightnessUp exec brightnessctl set 5%+
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

##############################
### WINDOWS AND WORKSPACES ###
##############################
for_window [class="nm-connection-editor"] floating enable
for_window [class="blueman-manager"] floating enable

# Dark Mode / Theme
exec_always {
    gsettings set org.gnome.desktop.interface gtk-theme "Catppuccin-Mocha"
    gsettings set org.gnome.desktop.interface color-scheme "prefer-dark"
    quickshell-message reload
}

include ~/.config/sway/noctalia
